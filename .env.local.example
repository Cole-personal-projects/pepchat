NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_KLIPY_API_KEY=your_klipy_api_key_here
# Required for admin operations (ban via Auth API, password reset lookup)
# Store in GitHub Secrets and Cloudflare Pages env vars — never expose client-side
SUPABASE_SERVICE_ROLE_KEY=

# Web push (VAPID). Generate a P-256 pair once; the public key ships to
# browsers, the private key stays server-side (Cloudflare Pages secret).
# Without these set, push delivery downgrades to a silent no-op.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI sent to push services with each request (RFC 8292).
VAPID_SUBJECT=mailto:admin@sidebarchat.net
